{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@engine": [
        "../engine/ts/gestationalAge.ts"
      ]
    },
    "types": [
      "jest"
    ]
  },
