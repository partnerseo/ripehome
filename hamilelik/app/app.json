{
  "expo": {
    "name": "Hamilelik",
    "slug": "hamilelik",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.hamilelik.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Karın fotoğrafı çekmek için kameraya erişim izni gerekir. Fotoğraflarınız yalnızca sizin hesabınızda saklanır.",
        "NSPhotoLibraryUsageDescription": "Zaman tünelinize fotoğraf eklemek için galerinize erişim izni gerekir. Seçtiğiniz fotoğraflar yalnızca sizin hesabınızda saklanır.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.hamilelik.mobile",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "scheme": "hamilelik",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Zaman tünelinize fotoğraf eklemek için galerinize erişim izni gerekir.",
          "cameraPermission": "Karın fotoğrafı çekmek için kameraya erişim izni gerekir."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7B3B58"
        }
      ]
    ],
    "primaryColor": "#7B3B58",
    "extra": {
      "router": {},
      "eas": {}
    }
  }
}
